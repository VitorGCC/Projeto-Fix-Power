@model LoginModel

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" integrity="sha384-k6RqeWeci5ZR/Lv4MR0sA0FfDOM4rj2u8zZ1H9qPpG5Q7eD4hT5gT3C3y7Y1K5" crossorigin="anonymous">
    <link rel="stylesheet" href="https://mdbcdn.com/css/mdb.min.css"> <!-- Inclua seu CSS MDB aqui -->
    <link rel="stylesheet" href="~/css/login.css">
</head>
<body>

@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger" role="alert">
        <button type="button" class="btn btn-danger btn-sm close-alert" data-bs-dismiss="alert" arial-label="Close">X</button>
        @TempData["MensagemErro"]
    </div>
}

<form id="loginForm" asp-controller="Login" asp-action="Entrar" aria-labelledby="loginFormTitle" method="post">
    <h2 id="loginFormTitle" class="mb-4 text-center">Entrar</h2>

    <!-- Campo de email -->
    <div data-mdb-input-init class="form-outline mb-3">
        <input type="email" asp-for="Email" id="email"class="form-control" required aria-required="true" />

        <label class="form-label" for="email">Endereço de e-mail</label>
    </div>

    <!-- Campo de senha -->
    <div data-mdb-input-init class="form-outline mb-3">
        <input type="password" asp-for="Senha" id="Senha" class="form-control" required aria-required="true" />
        
        <label class="form-label" for="Senha">Senha</label>
    </div>

    <!-- Checkbox e link para recuperação de senha -->
    <div class="row mb-3">
        <div class="col d-flex align-items-center">
            <!-- Checkbox -->
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="" id="rememberMe" checked />
                <label class="form-check-label" for="rememberMe"> Lembrar-me </label>
            </div>
        </div>
    </div>

    <!-- Botão de envio -->
    <button data-mdb-ripple-init type="submit" class="btn btn-primary btn-block mb-3">Entrar</button>

    <!-- Links verticais -->
    <div class="vertical-links">
        <a role="button" asp-action="Senha" asp-controller="Senha">Esqueceu a senha?</a>
        <p>Não é membro? <a role="button" asp-action="Registro" asp-controller="Usuario">Registrar</a></p>
    </div>
</form>

<script type="module">
    import { Input, Ripple, initMDB } from "mdb-ui-kit";

    // Inicialização do MDB
    initMDB({ Input, Ripple });
</script>

</body>
</html>
