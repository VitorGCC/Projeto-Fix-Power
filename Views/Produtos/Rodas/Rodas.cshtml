@{
    ViewData["Title"] = "Produtos";
}
<!DOCTYPE html>
<html lang="pt-br">

@{
    Layout = "_Layout";
}
@section styles {
    <link rel="stylesheet" href="~/css/produtos.css">
}

<body>
    <div class="col-content Pagina">
        <div class="produtos">
            <span class="breadcrumb-item flex align-center">
                <a href="/" class="home">Home</a>
            </span>
            <span class="breadcrumb-item">Rodas</span>
        </div>

        <div class="nomeItem">
            <h1>RODAS</h1>
        </div>

        @* PRIMEIRA FILEIRA ----------------------------------------------------*@
        <div class="d-flex justify-content-center mt-4">
            <div class="row row-cols-1 row-cols-md-4 g-4">
                <div class="col">
                    <div class="card">
                        <a title="Jogo de rodas C-SPEC 2 Aro 15 GT7 4x100" asp-controller="Produtos" asp-action="CSPEC">
                            <img src="~/img/Rodas/C-SPEC2Aro15.png" class="card-img-top" alt="C-SPEC 2 Aro 15 GT7"
                                id="C-SPEC">
                            <div class="card-body">
                                <p class="card-title">C-SPEC 2</p>
                                <div class="detalhes-valor-produto">
                                    <div class="price-product"> <span class="old-price">
                                            R$ 1.789,00 </span>
                                        <div class="primary-price"><span class="price-big">R$ 3.075,00</span><span
                                                class="tipo-valor"> no
                                                pix</span></div>
                                        <div class="secondary-price"><span class="parcelas">6x</span>
                                            de <span class="price-parcelado">R$ 282,67 </span></div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col">
                    <div class="card">
                        <a title="Jogo de rodas Dcenti LM103 5x114" asp-controller="Produtos" asp-action="Dcenti">
                            <img src="~/img/Rodas/DcentiLM103.png" class="card-img-top" alt="Dcenti LM103 5x114" id="Dcenti">
                            <div class="card-body">
                                <p class="card-title">Dcenti LM103 5x114s</p>
                                <div class="detalhes-valor-produto">
                                    <div class="price-product"> <span class="old-price">
                                            R$ 1.789,00 </span>
                                        <div class="primary-price"><span class="price-big">R$ 1.645,12</span><span
                                                class="tipo-valor"> no
                                                pix</span></div>
                                        <div class="secondary-price"><span class="parcelas">6x</span>
                                            de <span class="price-parcelado">R$ 282,67 </span></div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col">
                    <div class="card">
                        <a title="Jogo de rodas GT-7 BBS CH 18x7" asp-controller="Produtos" asp-action="GT7">
                            <img src="~/img/Rodas/GT-7BBSCH.png" class="card-img-top" alt="GT-7 BBS CH 18x7" id="GT-7BBSCH">
                            <div class="card-body">
                                <p class="card-title">GT-7 BBS CH 18x7</p>
                                <div class="detalhes-valor-produto">
                                    <div class="price-product"> <span class="old-price">
                                            R$ 1.789,00 </span>
                                        <div class="primary-price"><span class="price-big">R$ 1.645,12</span><span
                                                class="tipo-valor"> no
                                                pix</span></div>
                                        <div class="secondary-price"><span class="parcelas">6x</span>
                                            de <span class="price-parcelado">R$ 282,67 </span></div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col">
                    <div class="card">
                        <a title="Jogo de rodas Zeus HM10" asp-controller="Produtos" asp-action="Zeus">
                            <img src="~/img/Rodas/ZeusHM10.png" class="card-img-top" alt="Zeus HM10" id="ZeusHM10">
                            <div class="card-body">
                                <p class="card-title">Zeus HM10 15x7,5</p>
                                <div class="detalhes-valor-produto">
                                    <div class="price-product"> <span class="old-price">
                                            R$ 1.789,00 </span>
                                        <div class="primary-price"><span class="price-big">R$ 1.645,12</span><span
                                                class="tipo-valor"> no
                                                pix</span></div>
                                        <div class="secondary-price"><span class="parcelas">6x</span>
                                            de <span class="price-parcelado">R$ 282,67 </span></div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* SEGUNDA FILEIRA -----------------------------------------------------*@
        <div class="d-flex justify-content-center mt-4">
            <div class="row row-cols-1 row-cols-md-4 g-4">
                <div class="col">
                    <div class="card">
                        <a title="Jogo de rodas Roda Euro JDM" asp-controller="Produtos" asp-action="JDM">
                            <img src="~/img/Rodas/RodaEuroJDM.png" class="card-img-top" alt="C-SPEC 2 Aro 15 GT7 4x100"
                                id="C-SPEC">
                            <div class="card-body">
                                <p class="card-title">Roda Euro JDM</p>
                                <div class="detalhes-valor-produto">
                                    <div class="price-product"> <span class="old-price">
                                            R$ 1.789,00 </span>
                                        <div class="primary-price"><span class="price-big">R$ 3.075,00</span><span
                                                class="tipo-valor"> no
                                                pix</span></div>
                                        <div class="secondary-price"><span class="parcelas">6x</span>
                                            de <span class="price-parcelado">R$ 282,67 </span></div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col">
                    <div class="card">
                        <a title="Jogo de rodas Fuel Runner" asp-controller="Produtos" asp-action="Runner">
                            <img src="~/img/Rodas/RodaFuelRunner.png" class="card-img-top" alt="Dcenti LM103 5x114" id="Dcenti">
                            <div class="card-body">
                                <p class="card-title">Rodas Fuel Runner</p>
                                <div class="detalhes-valor-produto">
                                    <div class="price-product"> <span class="old-price">
                                            R$ 1.789,00 </span>
                                        <div class="primary-price"><span class="price-big">R$ 1.645,12</span><span
                                                class="tipo-valor"> no
                                                pix</span></div>
                                        <div class="secondary-price"><span class="parcelas">6x</span>
                                            de <span class="price-parcelado">R$ 282,67 </span></div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col">
                    <div class="card">
                        <a title="Jogo de rodas Rotiform TUF-R" asp-controller="Produtos" asp-action="Rotiform">
                            <img src="~/img/Rodas/RodaRotiformTUF-R.png" class="card-img-top" alt="GT-7 BBS CH 18x7" id="GT-7BBSCH">
                            <div class="card-body">
                                <p class="card-title">Rodas Rotiform TUF-R</p>
                                <div class="detalhes-valor-produto">
                                    <div class="price-product"> <span class="old-price">
                                            R$ 1.789,00 </span>
                                        <div class="primary-price"><span class="price-big">R$ 1.645,12</span><span
                                                class="tipo-valor"> no
                                                pix</span></div>
                                        <div class="secondary-price"><span class="parcelas">6x</span>
                                            de <span class="price-parcelado">R$ 282,67 </span></div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col">
                    <div class="card">
                        <a title="Jogo de rodas Fuel Burn" asp-controller="Produtos" asp-action="Burn">
                            <img src="~/img/Rodas/RodaFuelBurn.jpeg" class="card-img-top" alt="Zeus HM10" id="ZeusHM10">
                            <div class="card-body">
                                <p class="card-title">Rodas Fuel Burn</p>
                                <div class="detalhes-valor-produto">
                                    <div class="price-product"> <span class="old-price">
                                            R$ 1.789,00 </span>
                                        <div class="primary-price"><span class="price-big">R$ 1.645,12</span><span
                                                class="tipo-valor"> no
                                                pix</span></div>
                                        <div class="secondary-price"><span class="parcelas">6x</span>
                                            de <span class="price-parcelado">R$ 282,67 </span></div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

</body>

</html>