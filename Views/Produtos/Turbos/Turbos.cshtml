@{
    ViewData["Title"] = "Produtos";
}

<!DOCTYPE html>
<html lang="pt-br">

@{
    Layout = "_Layout";
}
@section styles {
    <link rel="stylesheet" href="~/css/produtos.css">
}

<body>
    <div class="col-content Pagina">
        <div class="produtos">
            <span class="breadcrumb-item flex align-center">
                <a href="/" class="home">Home</a>
