                                <p class="card-title">Turbo Alimentador TA4502</p>
                                <div class="detalhes-valor-produto">
                                    <div class="price-product"> <span class="old-price">
                                            R$ 1.789,00 </span>
                                        <div class="primary-price"><span class="price-big">R$ 1.645,12</span><span
                                                class="tipo-valor"> no
                                                pix</span></div>
                                        <div class="secondary-price"><span class="parcelas">6x</span>
                                            de <span class="price-parcelado">R$ 282,67 </span></div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
