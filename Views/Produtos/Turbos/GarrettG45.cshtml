@{
    ViewData["Title"] = "Turbo Alimentador H1E Simples";
}
<!DOCTYPE html>
<html lang="en">

@{
    Layout = "_Layout";
}
@section styles {
    <link rel="stylesheet" href="~/css/produtos.css">
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">

<body>
    <div class="col-content">
        <div class="produtos">
            <span class="breadcrumb-item flex align-center">
                <a href="/" class="home">Home</a>
            </span>
            <span class="breadcrumb-item flex align-center">
                <a href="/produtos/turbos" class="home">Turbos</a>
            </span>
            <span class="breadcrumb-item">Turbina Garrett G45-1500 A/R 1.15 – 888169-5005S – Garrett</span>
        </div>

        <div class="container mt-5">
            <div class="row">
                <!-- Product Images -->
                <div class="col-md-6 mb-4">
                    <img src="~/img/turbos/TurbinaGarretG45-1.jpg" alt="Product"
                        class="img-fluid rounded mb-3 product-image justify-content-center" id="mainImage">
                    <div class="d-flex justify-content-center gap-5">
                        <img src="~/img/turbos/TurbinaGarretG45-1.jpg" alt="Thumbnail 1"
                            class="thumbnail rounded active" onclick="changeImage(event, this.src)">
                        <img src="~/img/turbos/TurbinaGarretG45-2.jpg" alt="Thumbnail 2"
                            class="thumbnail rounded" onclick="changeImage(event, this.src)">
                    </div>
                </div>

                <!-- Product Details -->
                <div class="col-md-6">
                    <h2 class="mb-3">Turbina Garrett G45-1500 A/R 1.15 – 888169-5005S – Garrett</h2>
                    <div class="mb-3">
                        <div class="primary-price">
                            <span class="price-big">R$ 1.645,12 </span>
                            <span class="tipo-valor">no pix</span>
                        </div>
                        <section class="secondary-price"><span class="parcelas">6x</span>
                            de <span class="price-parcelado">R$ 292,83 </span></section>
                    </div>
                    <div class="mb-3">
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-half text-warning"></i>
                        <i class="bi bi-star text-warning"></i>
                        <span class="ms-2">3.5 (120 reviews)</span>
                    </div>
                   <button class="btn btn-primary btn-lg mb-3 me-2">
                        <i class="bi bi-cart-plus"></i><a style="color: inherit; text-decoration: none;" asp-controller="Carrinho" asp-action="Index">Adicionar</a>
                    </button>
                    <div class="mt-4">
                        <h5>Caracteristicas:</h5>
                        <ul>
                            <li>A/R Carcaça Compressora: .70</li>
                            <li>A/R Carcaça Turbina: .70</li>
                            <li>Carcaça: Pulsativa</li>
                            <li>Base Carcaça: H1E</li>
                            <li>Ajuste Atuador de Válvula: N/D </li>
                            <li>Garantia Fabricante: 12 meses</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <script src="~/js/site.js"></script>
</body>

</html>