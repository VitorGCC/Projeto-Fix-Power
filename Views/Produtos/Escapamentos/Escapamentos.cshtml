@{
    ViewData["Title"] = "Produtos";
}

<!DOCTYPE html>
<html lang="pt-br">

@{
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/produtos.css">
@section styles {
    <link rel="stylesheet" href="~/css/produtos.css">
}

<body>
    <div class="col-content Pagina">
        <div class="produtos">
            <span class="breadcrumb-item flex align-center">
                <a href="/" class="home">Home</a>
            </span>
            <span class="breadcrumb-item">Escapamentos</span>
        </div>

        <div class="nomeItem">
            <h1>Escapamentos</h1>
        </div>

        @* PRIMEIRA FILEIRA ----------------------------------------------------*@
        <div class="d-flex justify-content-center mt-4">
            <div class="row row-cols-1 row-cols-md-4 g-4">
                <div class="col">
                    <div class="card">
                        <a title="Escapamento Golf MK7" asp-controller="Produtos" asp-action="GolfMK7">
                            <section class="imgEscape">
                            <img src="~/img/Escapamentos/ESCAPAMENTO-GOLF-MK7.png" class="card-img-top" alt="Escapamento Golf MK7"
                                id="C-SPEC">
                                </section>
                            <div class="card-body">
                                <p class="card-title">Escapamento Golf MK7</p>
                                <div class="detalhes-valor-produto">
                                    <div class="price-product"> <span class="old-price">
                                            R$ 1.789,00 </span>
                                        <div class="primary-price"><span class="price-big">R$ 3.075,00</span><span
                                                class="tipo-valor"> no
                                                pix</span></div>
                                        <div class="secondary-price"><span class="parcelas">6x</span>
                                            de <span class="price-parcelado">R$ 282,67 </span></div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
