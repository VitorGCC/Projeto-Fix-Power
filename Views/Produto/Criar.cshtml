@model ProdutoModel
@{
  ViewData["Title"] = "Pagina de Contato";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Aula_17_31._10._24.styles.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/styles.css">
<div class="text-center">
  <form asp-controller="Produto" asp-action="Criar" method="post">
    <div class="form-group">
      <label for="exampleInputEmail1">Nome</label>
      <input type="text" asp-for="Nome" class="form-control" placeholder="Seu Nome">
    </div>
    <div class="form-group">
      <label for="preco">Preço</label>
      <input type="number" step="0.01" min="0.01" max="9999999.99" asp-for="Preco" class="form-control"
        placeholder="Digite o preço">
    </div>
    <div class="form-group">
      <label for="quantidade">Quantidade</label>
      <input type="number" maxlength="100" asp-for="Quantidade" class="form-control" placeholder="Digite a quantidade">
    </div>
  <div class="form-group">
      <label for="categoria">Categoria</label>
      <input type="Text" maxlength="100" asp-for="Categoria" class="form-control" placeholder="Digite a Categoria">
    </div>
    <div class="form-group">
      <label for="descricao">Descrição:</label>
      <input value="" type="text" id="categoria" asp-for="Descricao" class="form-control" name="descricao"
        placeholder="Digite a descrição">
    </div>
      <button type="submit" class="btn btn-danger btn-lg btn-block">Confirmar</button>
      <a role="button" asp-controller="Produto" asp-action="Index" class="btn btn-secondary btn-lg btn-block">Voltar</a>
  </form>
  <script>
    function mascaraTelefone(input) {
      let valor = input.value;
      valor = valor.replace(/\D/g, "");

      // Aplica a máscara (00) 00000-0000
      valor = valor.replace(/^(\d{2})(\d)/g, "($1) $2");
      valor = valor.replace(/(\d{5})(\d)/, "$1-$2");

      // Atualiza o valor do campo
      input.value = valor;
    }
  </script>
</div>
